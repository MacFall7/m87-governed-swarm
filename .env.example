# M87 Governed Swarm - Environment Configuration
# Copy this to .env and customize for your deployment

# ---- P0.A: Scoped API Keys ----
# Bootstrap key (admin-only). CHANGE THIS to a long random secret.
M87_BOOTSTRAP_KEY=change-this-to-a-long-random-secret

# Legacy key (backward compat — new deployments should use scoped keys below)
M87_API_KEY=change-this-to-a-long-random-secret

# Per-service scoped keys (generated once, seeded at startup)
# Each service gets only the endpoints/effects it needs.
# Leave empty to skip seeding (service falls back to M87_API_KEY).
M87_RUNNER_KEY=
M87_CASEY_KEY=
M87_JORDAN_KEY=
M87_RILEY_KEY=
M87_NOTIFIER_KEY=

# ---- Environment ----
# dev | staging | prod — affects kill-switch lockdown and security defaults
M87_ENV=dev

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Postgres ----
POSTGRES_PASSWORD=m87-dev-password

# ---- Notifications ----
# Webhook URL for notifications (Slack, Discord, etc.)
# Leave empty to disable webhook notifications
WEBHOOK_URL=

# ---- Test/Debug ----
# Enable test endpoints (/v1/admin/emit) - ONLY for running proof tests
M87_ENABLE_TEST_ENDPOINTS=false

# ---- P1.B: Kill-switch ----
# Emergency-only: bypass Phase 3-6 governance (requires authorization in prod)
# M87_DISABLE_PHASE36_GOVERNANCE=0
# M87_KILLSWITCH_OVERRIDE_PATH=

# ---- P2.A: Rate Limiting ----
# Max proposals per minute per principal (default: 30)
# M87_RATE_LIMIT_PROPOSALS_PER_MIN=30

# ---- P3: Runner-Environment Hardening (opt-in) ----
# These checks verify Linux-level isolation guarantees at the runner.
# Default off because dev/CI environments often don't provide real
# namespace isolation. Enable in production where the runner has
# the privileges to verify these invariants.
#
# Network namespace verification (runner cannot reach internet
# except via governed_request)
# M87_NETWORK_CHECK_ENABLED=1
#
# Linux capability check (runner runs with no elevated capabilities)
# M87_CAP_CHECK_ENABLED=1
#
# Mount-invariant check (runner sandbox mounts match declared envelope)
# M87_MOUNT_CHECK_ENABLED=1
#
# Quarantine state machine (escalates posture on integrity signals;
# in-memory only as of v2 scaffolding; see docs/HARDENING.md)
# M87_QUARANTINE_ENABLED=1

# ---- Service-internal config (defaults shown; uncomment to override) ----
# These have sensible defaults baked into each service. Uncomment only
# if you need to override.
#
# Adapter polling interval (seconds)
# POLL_INTERVAL=5
# LOG_LEVEL=INFO
#
# Runner / job dispatcher tuning
# M87_MAX_RUNNER_TEXT_FIELD=4096
# M87_DISPATCH_MODE=redis
# DISPATCHER_NAME=default
# RUNNER_NAME=default
# RESULT_POLL_SECONDS=2
# RESULT_TIMEOUT_SECONDS=300
# RESULT_QUEUE_PATH=/tmp/m87/results
# JOB_QUEUE_PATH=/tmp/m87/jobs
#
# File-based dispatch (alternative to Redis streams)
# M87_FILE_INCOMING=/tmp/m87/incoming
# M87_FILE_OUTGOING=/tmp/m87/outgoing
#
# Build / deploy provenance
# M87_BUILD_ID=
#
# Sandbox + tool manifest paths (set automatically by docker-compose)
# M87_SANDBOX_ROOT=/sandbox
# M87_TOOL_MANIFEST_PATH=/app/tool_manifest.json
# M87_MANIFEST_LOCK_PATH=/app/manifest.lock.json
#
# Rate limiting (cost-based, in addition to per-key proposal limits)
# M87_RATE_LIMIT_EVAL_COST_PER_MIN=1000
#
# API base URLs (set automatically by docker-compose)
# API_BASE=http://api:8000
# M87_API_BASE=http://api:8000

# ---- Runner ----
M87_MAX_RUNNER_RESULT_BYTES=65536
# Challenge secret for Phase 3-6 adversarial review
M87_CHALLENGE_SECRET=change-me-in-production
